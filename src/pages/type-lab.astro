---
// THROWAWAY — display-face specimen for the industrial template.
//
// Not linked from anywhere, excluded from the sitemap, noindex. Delete this
// file and the /type-lab line in astro.config.mjs once the face is chosen.
//
// The candidates are all OFL families on Google Fonts, which matters: the
// site's subsetting pipeline (scripts/build-fonts.py) pulls from
// raw.githubusercontent.com/google/fonts/main/ofl/, so whichever one wins
// drops in with a few lines in FACES and gets self-hosted and subset like
// everything else.
//
// Bender, the face Arknights actually uses, is deliberately absent. Its
// licence is contradictory across resellers -- 1001 Fonts calls it OFL and
// free, FFonts calls it personal-use-only, WeeklyFonts allows commercial use
// but marks webfont licence "No" -- and serving a .woff2 is exactly the use
// in dispute. It would need the designer's own licence text before it could
// ship.
//
// NOTE: this page loads the candidates from Google's CDN so they can be
// compared without touching the pipeline first. Production would never do
// that -- the whole point of build-fonts.py is that nothing is fetched from
// a third party at runtime.
import '../styles/global.css';

const FACES = [
  {
    name: 'Zen Kaku Gothic New',
    stack: "'Zen Kaku Gothic New', sans-serif",
    note: 'Live now. Carries display, body and Japanese alike. Clean, but it is a humanist gothic doing an industrial job — the reason this page exists.',
    flag: 'current'
  },
  {
    name: 'Oxanium',
    stack: "'Oxanium', sans-serif",
    note: 'Squared techno, drawn for game interfaces. The closest of the four to Bender’s character — flat terminals, squared bowls, slightly narrow.'
  },
  {
    name: 'Saira Semi Condensed',
    stack: "'Saira Semi Condensed', sans-serif",
    note: 'Squarish grotesque, more neutral than the others. The one most likely to still look right in three years, and the least costume-like.'
  },
  {
    name: 'Chakra Petch',
    stack: "'Chakra Petch', sans-serif",
    note: 'Angular with clipped corners, which rhymes with the chamfers already in the design. Risk: the clipped corners can read as novelty at large sizes.'
  },
  {
    name: 'Rajdhani',
    stack: "'Rajdhani', sans-serif",
    note: 'Squared and slightly condensed. Competent but the most generic of the four — it has been the default “techy” pick for a decade.'
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Type lab — display face</title>
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Oxanium:wght@400;500;600&family=Saira+Semi+Condensed:wght@400;500;600&family=Chakra+Petch:wght@400;500;600&family=Rajdhani:wght@400;500;600&display=swap"
    />
  </head>

  <body>
    <main class="lab">
      <header class="lab-head">
        <p class="lab-eyebrow">
          <span class="marker" aria-hidden="true"></span>
          <span>Display face — candidates</span>
        </p>
        <h1 class="lab-title">TYPE LAB</h1>
        <p class="lab-note">
          All four candidates are OFL families on Google Fonts, so whichever wins
          gets self-hosted and subset by the existing pipeline. Bender — the face
          Arknights actually uses — is not here: its licence is contradictory
          across resellers and webfont embedding is the disputed use. Body text
          stays on Zen Kaku Gothic New either way, and so do all Japanese
          headings, since none of these cover kana.
        </p>
      </header>

      <!-- The quickest comparison: one word, every face, same size. -->
      <section class="strip">
        <h2 class="lab-sub">The name, at hero size</h2>
        {
          FACES.map((f) => (
            <div class="strip-row">
              <span class="strip-label">{f.name}</span>
              <span class="strip-word" style={`font-family:${f.stack}`}>
                UTEYTITHYA NUON
              </span>
            </div>
          ))
        }
      </section>

      <!-- Then each face against the real content it has to set. -->
      {
        FACES.map((f) => (
          <section class="spec" style={`font-family:${f.stack}`}>
            <div class="spec-head">
              <h2 class="spec-name" style="font-family:'Zen Kaku Gothic New',sans-serif">
                {f.name}
              </h2>
              {f.flag && <span class="spec-flag">{f.flag}</span>}
            </div>
            <p
              class="spec-note"
              style="font-family:'Zen Kaku Gothic New',sans-serif"
            >
              {f.note}
            </p>

            <div class="spec-body">
              <p class="spec-eyebrow">BACKEND / ML / MOBILE</p>
              <p class="spec-hero">UTEYTITHYA NUON</p>
              <p class="spec-section">SELECTED WORK</p>
              <p class="spec-card">INTERNLINK — CV MODEL</p>
              <p class="spec-label">VIEW WORK · GET IN TOUCH · TOOLS &amp; CRAFT</p>
              <p class="spec-num">01 · 02 · 03 · 2025 · 4,817 · p99 240ms</p>

              {/* Japanese cannot use these faces, so it is shown as it would
                  actually render — on Zen Kaku, beside the Latin. */}
              <p
                class="spec-ja"
                lang="ja"
                style="font-family:'Zen Kaku Gothic New',sans-serif"
              >
                作品集 ・ わたしについて ・ 道具と技
              </p>

              <p
                class="spec-prose"
                style="font-family:'Zen Kaku Gothic New',sans-serif"
              >
                A backend developer drawn to the part nobody sees — the services,
                schemas, and pipelines everything else stands on. Body copy stays
                on Zen Kaku whichever face wins, so this line should look
                identical in every block.
              </p>
            </div>
          </section>
        ))
      }
    </main>

    <style>
      .lab {
        max-width: 1100px;
        margin: 0 auto;
        padding: clamp(32px, 6vw, 80px) clamp(20px, 5vw, 48px) 25vh;
      }

      .lab-head {
        padding-bottom: 40px;
        border-bottom: 1px solid var(--edge-strong);
      }

      .lab-eyebrow {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
        font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
        font-size: 11.5px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--volt);
      }

      .lab-title {
        margin: 14px 0 0;
        font-size: clamp(38px, 7vw, 68px);
        line-height: 1;
        letter-spacing: 0.01em;
        color: var(--bone);
      }

      .lab-note {
        margin: 18px 0 0;
        max-width: 68ch;
        color: var(--ash);
        font-size: 15px;
      }

      .lab-sub {
        margin: 0 0 20px;
        font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
        font-size: 11.5px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--ash-faint);
      }

      /* ── The strip ─────────────────────────────── */

      .strip {
        padding: 44px 0;
        border-bottom: 1px solid var(--edge-strong);
      }

      .strip-row {
        display: grid;
        grid-template-columns: 180px minmax(0, 1fr);
        gap: 20px;
        align-items: baseline;
        padding: 14px 0;
        border-top: 1px solid var(--edge);
      }

      .strip-label {
        font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
        font-size: 11px;
        letter-spacing: 0.08em;
        color: var(--ash-faint);
      }

      .strip-word {
        font-size: clamp(24px, 4vw, 44px);
        font-weight: 500;
        line-height: 1.1;
        color: var(--bone);
        word-break: break-word;
      }

      /* ── Per-face blocks ───────────────────────── */

      .spec {
        padding: 48px 0;
        border-bottom: 1px solid var(--edge-strong);
      }

      .spec-head {
        display: flex;
        align-items: baseline;
        gap: 14px;
      }

      .spec-name {
        margin: 0;
        font-size: 20px;
        font-weight: 500;
        letter-spacing: 0.04em;
        color: var(--volt);
      }

      .spec-flag {
        font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
        font-size: 10.5px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--void);
        background-color: var(--volt);
        padding: 3px 8px;
      }

      .spec-note {
        margin: 10px 0 0;
        max-width: 72ch;
        font-size: 14px;
        color: var(--ash);
      }

      .spec-body {
        margin-top: 30px;
        background-color: var(--steel);
        clip-path: var(--clip-chamfer);
        padding: clamp(24px, 3.5vw, 40px);
      }

      .spec-body > p {
        margin: 0 0 22px;
      }

      .spec-body > p:last-child {
        margin-bottom: 0;
      }

      .spec-eyebrow {
        font-size: 12px;
        letter-spacing: 0.22em;
        color: var(--volt);
      }

      .spec-hero {
        font-size: clamp(34px, 6vw, 62px);
        font-weight: 500;
        line-height: 1.04;
        letter-spacing: 0.005em;
        color: var(--bone);
      }

      .spec-section {
        font-size: clamp(26px, 4vw, 42px);
        font-weight: 500;
        line-height: 1.1;
        color: var(--bone);
      }

      .spec-card {
        font-size: 27px;
        font-weight: 500;
        line-height: 1.2;
        color: var(--bone);
      }

      .spec-label {
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.14em;
        color: var(--ash);
      }

      /* Numerals matter more than usual here: the site sets years, counts and
         measurements in several places, and squared faces vary a lot in how
         legible their digits are. */
      .spec-num {
        font-size: 15px;
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.04em;
        color: var(--signal);
      }

      .spec-ja {
        font-size: 20px;
        color: var(--ash);
      }

      .spec-prose {
        max-width: 64ch;
        font-size: 15.5px;
        line-height: 1.7;
        color: var(--ash);
      }

      @media (max-width: 680px) {
        .strip-row {
          grid-template-columns: minmax(0, 1fr);
          gap: 6px;
        }
      }
    </style>
  </body>
</html>
