---
// THROWAWAY — side-by-side type specimens for choosing the display and body
// faces. Not linked from anywhere, excluded from the sitemap, and noindex.
// Delete this file (and the /font-lab line in astro.config.mjs) when settled.
import en from '../i18n/en.json';

const display = [
  {
    name: 'Zen Old Mincho',
    note: 'Live now. Same family as the Japanese body face — Latin and kana drawn together, so both locales share one skeleton. Brush-derived serifs.',
    weights: '400;500;600',
    flag: 'Now live'
  },
  {
    name: 'Playfair Display',
    note: 'The previous face. A Didone — vertical stress, hairline serifs, engraving lineage. A different ancestry from Mincho, and very widely used.',
    weights: '500;600;700',
    flag: 'Previous'
  },
  {
    name: 'EB Garamond',
    note: 'Old-style, calligraphic, low contrast, warm. The quiet choice — but bookish, and softer at hero size.',
    weights: '400;500;600'
  },
  {
    name: 'Cormorant Garamond',
    note: 'Garamond skeleton with very fine hairlines. Echoes the 0.5px gold rules. Fragile below ~24px.',
    weights: '400;500;600'
  },
  {
    name: 'Newsreader',
    note: 'Editorial old-style. Suits the masthead / index-numeral / plate-number print language already in the design.',
    weights: '400;500;600'
  },
  {
    name: 'Instrument Serif',
    note: 'High-contrast display, current, distinctive. Ships weight 400 only — display styles use 500/600, so it would need restyling.',
    weights: '400'
  }
];

const body = [
  {
    name: 'Inter',
    note: 'Live now. Designed for user interfaces — superb at small letter-spaced labels and numerals, but the most-used sans on the web, and it reads more product than paper in running text.',
    weights: '400;500;600',
    flag: 'Now live'
  },
  {
    name: 'Zen Kaku Gothic New',
    note: 'Already loaded for Japanese body text, so choosing it here costs no extra family — the whole site would run on two. Same designer as Zen Old Mincho. The question is whether its Latin holds up over long English paragraphs.',
    weights: '400;500;700',
    flag: 'Two families total'
  },
  {
    name: 'Work Sans',
    note: 'Humanist, warm, a little quirky. A safe step away from Inter without losing clarity at label sizes.',
    weights: '400;500;600'
  },
  {
    name: 'Source Sans 3',
    note: 'Humanist, highly readable, unfussy. The most conservative upgrade — quieter than Inter, still crisp small.',
    weights: '400;500;600'
  },
  {
    name: 'IBM Plex Sans',
    note: 'Humanist with an engineered edge. Less ubiquitous than Inter, and the slight technical character suits backend work.',
    weights: '400;500;600'
  },
  {
    name: 'Alegreya Sans',
    note: 'Calligraphic origins, genuinely warm, the strongest "craft" feel. Also the most idiosyncratic — check the lowercase against long copy.',
    weights: '400;500;700'
  }
];

const families = [...display, ...body]
  .map((c) => `family=${c.name.replace(/ /g, '+')}:wght@${c.weights}`)
  .join('&');

const fontCss = `https://fonts.googleapis.com/css2?${families}&display=swap`;

const lead = en.about.body1;
const heroBody = en.hero.body;
const chips = ['Python', 'FastAPI', 'LayoutLM', 'Docker'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Type specimen — display &amp; body</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontCss} />
    <style is:global>
      :root {
        --washi: #f7f3eb;
        --washi-warm: #fbf8f1;
        --sumi-ink: #2b2928;
        --stone: #57524c;
        --indigo: #223a5e;
        --vermilion: #c73e3a;
        --gold: #c9a96e;
        --gold-ink: #856830;
        --paper-edge: rgba(0, 0, 0, 0.08);
      }

      /* This page stands alone — it does not pull in global.css or Tailwind's
         reset, so without this the sticky bar's padding adds to its width and
         pushes the page sideways. */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--washi);
        color: var(--sumi-ink);
        font-family: Inter, sans-serif;
        font-size: 17px;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
      }

      .wrap {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 24px 120px;
      }

      .lab-nav {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        gap: 20px;
        align-items: baseline;
        background: rgba(247, 243, 235, 0.9);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--paper-edge);
        /* Full-bleed: this sits outside .wrap, so it needs no negative margins
           to escape the wrap's padding — it is already at the page edge. */
        padding: 14px 24px;
        margin: 0;
        font-family: Inter, sans-serif;
      }

      .lab-nav a {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--indigo);
        text-decoration: none;
        border-bottom: 1px solid transparent;
      }

      .lab-nav a:hover {
        border-bottom-color: var(--indigo);
      }

      .lab-nav span {
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--stone);
        opacity: 0.7;
      }

      .part {
        padding-top: 56px;
      }

      .part-head {
        border-bottom: 1px solid var(--paper-edge);
        padding-bottom: 24px;
      }

      .part-title {
        font-family: Inter, sans-serif;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--vermilion);
        margin: 0;
      }

      .part-sub {
        font-family: Inter, sans-serif;
        color: var(--stone);
        max-width: 64ch;
        margin: 12px 0 0;
        font-size: 15px;
      }

      .spec {
        padding: 52px 0;
        border-bottom: 1px solid var(--paper-edge);
      }

      .spec-head {
        display: flex;
        align-items: baseline;
        gap: 14px;
        flex-wrap: wrap;
        margin-bottom: 6px;
      }

      .spec-name {
        font-family: Inter, sans-serif;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--indigo);
      }

      .spec-flag {
        font-family: Inter, sans-serif;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--washi);
        background: var(--vermilion);
        padding: 3px 9px;
        border-radius: 2px;
      }

      .spec-flag--muted {
        background: var(--stone);
      }

      .spec-flag--good {
        background: var(--indigo);
      }

      .spec-note {
        font-family: Inter, sans-serif;
        font-size: 14px;
        color: var(--stone);
        max-width: 72ch;
        margin: 0 0 32px;
      }

      /* ── display specimen bits ────────────────────────── */

      .eyebrow {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--vermilion);
        margin: 0;
      }

      .hero {
        font-size: clamp(44px, 5.6vw, 72px);
        font-weight: 600;
        line-height: 1.08;
        letter-spacing: 0;
        margin: 14px 0 0;
      }

      .stroke {
        display: block;
        width: 320px;
        max-width: 80%;
        margin-top: 10px;
        color: var(--indigo);
        opacity: 0.5;
      }

      .subtitle {
        font-size: 20px;
        color: var(--stone);
        margin: 20px 0 0;
      }

      .rule {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-top: 46px;
      }

      .rule-kanji {
        font-size: 15px;
        color: var(--vermilion);
      }

      .rule-line {
        flex: 1;
        height: 1px;
        background: linear-gradient(
          to right,
          rgba(0, 0, 0, 0.14),
          rgba(0, 0, 0, 0.03)
        );
      }

      .rule-num {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.22em;
        color: var(--stone);
        opacity: 0.7;
      }

      .section-title {
        font-size: clamp(32px, 3.6vw, 52px);
        font-weight: 500;
        line-height: 1.15;
        margin: 20px 0 0;
      }

      .section-sub {
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: var(--gold-ink);
        margin: 12px 0 0;
      }

      .card-title {
        font-size: 31px;
        font-weight: 500;
        line-height: 1.2;
        margin: 0;
      }

      .ja {
        margin-top: 36px;
        padding-top: 24px;
        border-top: 1px dashed var(--paper-edge);
      }

      .ja-title {
        font-size: clamp(28px, 3.2vw, 44px);
        font-weight: 500;
        line-height: 1.4;
        margin: 0;
      }

      .flag-line {
        font-family: Inter, sans-serif;
        font-size: 11px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--stone);
        opacity: 0.6;
        margin: 0 0 12px;
      }

      /* ── body specimen bits ───────────────────────────── */

      .cols {
        display: grid;
        gap: 44px;
        grid-template-columns: 1fr;
      }

      @media (min-width: 900px) {
        .cols {
          grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
        }
      }

      .lead {
        font-size: 19px;
        line-height: 1.75;
        color: var(--sumi-ink);
        margin: 0;
      }

      .para {
        font-size: 17px;
        line-height: 1.7;
        color: var(--stone);
        margin: 18px 0 0;
        max-width: 68ch;
      }

      /* the micro-typography panel — where Inter currently earns its keep */
      .micro {
        background: var(--washi-warm);
        border: 1px solid rgba(0, 0, 0, 0.06);
        border-radius: 2px;
        padding: 24px;
      }

      .micro-row {
        padding: 12px 0;
        border-bottom: 1px solid var(--paper-edge);
      }

      .micro-row:last-child {
        border-bottom: 0;
      }

      .micro-key {
        font-family: Inter, sans-serif;
        font-size: 10px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--stone);
        opacity: 0.55;
        display: block;
        margin-bottom: 6px;
      }

      .m-label {
        font-size: 14px;
        font-weight: 500;
        letter-spacing: 0.08em;
      }

      .m-tag {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--indigo);
      }

      .m-num {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.22em;
        color: var(--stone);
      }

      .m-period {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.22em;
        color: var(--stone);
        opacity: 0.75;
      }

      .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .chip {
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.08em;
        color: var(--stone);
        border: 1px solid var(--paper-edge);
        border-radius: 2px;
        padding: 4px 10px;
      }
    </style>
  </head>
  <body>
    <nav class="lab-nav">
      <a href="#display">Display</a>
      <a href="#body">Body</a>
      <span>throwaway page — not indexed</span>
    </nav>

    <div class="wrap">
      <!-- ══ DISPLAY ══════════════════════════════════════ -->
      <section class="part" id="display">
        <header class="part-head">
          <p class="part-title">Part one — display face</p>
          <p class="part-sub">
            Real copy, real sizes, real paper. Everything below the headings is
            held in Inter, so the display face is the only variable. The Japanese
            block on each shows whether that face carries kana and kanji itself
            or hands them to a fallback.
          </p>
        </header>

        {
          display.map((c) => (
            <section class="spec" style={`font-family: '${c.name}', serif`}>
              <div class="spec-head">
                <span class="spec-name">{c.name}</span>
                {c.flag && (
                  <span
                    class:list={[
                      'spec-flag',
                      { 'spec-flag--muted': c.flag === 'Previous' }
                    ]}
                  >
                    {c.flag}
                  </span>
                )}
              </div>
              <p class="spec-note">{c.note}</p>

              <p class="eyebrow">{en.hero.eyebrow}</p>
              <h2 class="hero">{en.hero.headline}</h2>
              <svg
                class="stroke"
                viewBox="0 0 320 18"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <path
                  d="M2 11.5C34 5.5 78 3.2 128 4.4c46 1.1 92 4.6 138 2.2 22-1.1 38-2.4 52-4.1"
                  stroke="currentColor"
                  stroke-width="5"
                  stroke-linecap="round"
                />
              </svg>
              <p class="subtitle">{en.hero.subtitle}</p>

              <div class="rule">
                <span class="rule-kanji">{en.work.kanji}</span>
                <span class="rule-line" />
                <span class="rule-num">{en.work.num}</span>
              </div>
              <h3 class="section-title">{en.work.title}</h3>
              <p class="section-sub">{en.work.sub}</p>
              <h4 class="card-title" style="margin-top:28px">
                InternLink — CV Model
              </h4>

              <div class="ja" lang="ja">
                <p class="flag-line">Japanese — same face, or fallback?</p>
                <h4 class="ja-title">作品集 — 縁の下の力持ち</h4>
              </div>
            </section>
          ))
        }
      </section>

      <!-- ══ BODY ═════════════════════════════════════════ -->
      <section class="part" id="body">
        <header class="part-head">
          <p class="part-title">Part two — body face</p>
          <p class="part-sub">
            The body slot is really two jobs. On the left is running text, where
            Inter feels generic. On the right is the micro-typography — small
            letter-spaced uppercase labels and numerals — which is the job Inter
            was actually built for and where a warmer face can go soft. Judge both
            before deciding; they do not always point the same way. All headings
            here stay in Zen Old Mincho.
          </p>
        </header>

        {
          body.map((c) => (
            <section class="spec" style={`font-family: '${c.name}', sans-serif`}>
              <div class="spec-head">
                <span class="spec-name">{c.name}</span>
                {c.flag && (
                  <span
                    class:list={[
                      'spec-flag',
                      { 'spec-flag--good': c.flag === 'Two families total' }
                    ]}
                  >
                    {c.flag}
                  </span>
                )}
              </div>
              <p class="spec-note">{c.note}</p>

              <div class="cols">
                <div>
                  <h3
                    class="section-title"
                    style="font-family:'Zen Old Mincho',serif; font-size:34px; margin-bottom:18px"
                  >
                    About
                  </h3>
                  <p class="lead">{lead}</p>
                  <p class="para">{heroBody}</p>
                </div>

                <div class="micro">
                  <div class="micro-row">
                    <span class="micro-key">Nav label · .label</span>
                    <span class="m-label">Work &nbsp; About &nbsp; Contact</span>
                  </div>
                  <div class="micro-row">
                    <span class="micro-key">Eyebrow · 0.3em uppercase</span>
                    <span class="eyebrow">{en.hero.eyebrow}</span>
                  </div>
                  <div class="micro-row">
                    <span class="micro-key">Category · .tag</span>
                    <span class="m-tag">Backend &amp; AI Developer</span>
                  </div>
                  <div class="micro-row">
                    <span class="micro-key">Section numerals · .header-num</span>
                    <span class="m-num">01 &nbsp; 02 &nbsp; 03 &nbsp; 04 &nbsp; 05</span>
                  </div>
                  <div class="micro-row">
                    <span class="micro-key">Timeline period</span>
                    <span class="m-period">JAN 2026 — JUL 2026</span>
                  </div>
                  <div class="micro-row">
                    <span class="micro-key">Stack chips</span>
                    <ul class="chips">
                      {chips.map((s) => (
                        <li class="chip">{s}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            </section>
          ))
        }
      </section>
    </div>
  </body>
</html>
