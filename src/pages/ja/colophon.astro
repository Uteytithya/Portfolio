---
import BaseLayout from '../../components/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Colophon from '../../components/Colophon.astro';
import Contact from '../../components/Contact.astro';
import t from '../../i18n/ja.json';

const locale = 'ja';
---

<BaseLayout
  locale={locale}
  title={`${t.colophon.title} — ${t.siteTitle}`}
  description={t.colophon.intro}
>
  <Navigation slot="nav" locale={locale} t={t} />
  <div class="pt-8">
    <a href={`/${locale}/`} class="label text-ash hover:text-signal">{t.back}</a>
  </div>
  <Colophon locale={locale} t={t} />
  <Contact slot="footer" locale={locale} t={t} />
</BaseLayout>
