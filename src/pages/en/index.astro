---
import BaseLayout from '../../components/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import WorkSection from '../../components/WorkSection.astro';
import TechStack from '../../components/TechStack.astro';
import Contact from '../../components/Contact.astro';
import t from '../../i18n/en.json';

const locale = 'en';
---

<BaseLayout locale={locale} title={t.siteTitle} description={t.hero.subtitle}>
  <Navigation slot="nav" locale={locale} t={t} />
  <Hero locale={locale} t={t} />
  <About locale={locale} t={t} />
  <WorkSection locale={locale} t={t} />
  <TechStack locale={locale} t={t} />
  <Contact slot="footer" locale={locale} t={t} />
</BaseLayout>
