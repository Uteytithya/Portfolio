---
import LanguageSwitcher from './LanguageSwitcher.jsx';
import Console from './Console.astro';

const { locale, t } = Astro.props;
const base = `/${locale}`;
const path = Astro.url.pathname;

// `section` ties a link to the id the scrollspy watches on the home page;
// `match` marks it active on a sub-route, where there is nothing to spy on.
const links = [
  { href: `${base}/#work`, label: t.nav.work, section: 'work', match: '/projects' },
  { href: `${base}/#about`, label: t.nav.about, section: 'about', match: null },
  {
    href: `${base}/#contact`,
    label: t.nav.contact,
    section: 'contact',
    match: null
  }
];

const isActive = (link) => link.match !== null && path.includes(link.match);
---

<header class="site-nav sticky top-0 z-40">
  <div
    class="mx-auto flex h-16 w-full max-w-site items-center justify-end gap-8 px-6 md:px-16"
  >
    <nav class="hidden items-center gap-8 md:flex" aria-label="Main">
      {
        links.map((link) => (
          <a
            href={link.href}
            data-section={link.section}
            class:list={['nav-link label', { 'nav-link--active': isActive(link) }]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <Console locale={locale} t={t} />

    <LanguageSwitcher client:load locale={locale} path={path} />

    <button
      type="button"
      class="nav-hamburger md:hidden"
      data-menu-toggle
      aria-label="Menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      三
    </button>
  </div>

  <nav id="mobile-menu" class="hidden md:hidden" aria-label="Main mobile">
    <div class="flex flex-col items-start gap-5 px-6 pb-8 pt-4">
      {
        links.map((link) => (
          <a href={link.href} data-section={link.section} class="nav-link label">
            {link.label}
          </a>
        ))
      }
      <!-- There is no keyboard on a phone to press ⌘K with, and the header has
           no room for the button, so the console's way in lives here. -->
      <button type="button" class="nav-link label mobile-console" data-console-open>
        {t.console.trigger}
      </button>
    </div>
  </nav>
</header>

<style>
  .site-nav {
    /* Transparent over void at rest — only a breath of a border below. */
    border-bottom: 1px solid transparent;
    background-color: transparent;
    transition: background-color 400ms ease, border-color 400ms ease,
      box-shadow 400ms ease;
  }

  /* Once the page has moved, the bar earns a surface — otherwise project images
     and the dark tech plate slide underneath the links and swallow them. */
  .site-nav--scrolled {
    background-color: rgba(11, 12, 14, 0.78);
    backdrop-filter: saturate(140%) blur(12px);
    -webkit-backdrop-filter: saturate(140%) blur(12px);
    border-bottom-color: var(--edge-strong);
    box-shadow: 0 1px 0 0 rgba(232, 220, 85, 0.12);
  }

  /* Without backdrop-filter the translucency would let text collide with what
     is behind it, so those browsers get an opaque bar instead. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-nav--scrolled {
      background-color: var(--void);
    }
  }

  #mobile-menu {
    background-color: var(--steel);
    border-bottom: 1px solid var(--edge-strong);
  }

  .nav-link {
    color: var(--bone);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: border-color 300ms ease, color 300ms ease;
  }

  .nav-link:hover {
    color: var(--volt);
  }

  /* Active is volt, like every other "this one is live" state on the site.
     It was alert red, which on an industrial surface reads as a fault. */
  .nav-link--active {
    color: var(--volt);
    border-bottom-color: var(--volt);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav {
      transition: none;
    }
  }

  /* Marked with the same diamond the console's own trigger carries, so the two
     entry points read as one thing. */
  .mobile-console {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: none;
    text-align: left;
  }

  .mobile-console::before {
    content: '';
    width: 6px;
    height: 6px;
    background-color: var(--volt);
    transform: rotate(45deg);
    flex-shrink: 0;
  }

  .nav-hamburger {
    font-family: 'Zen Kaku Gothic New', sans-serif;
    font-size: 18px;
    line-height: 1;
    color: var(--bone);
    /* The glyph stays small; the tap area does not. 44px is the floor for a
       comfortable touch target. */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    margin-right: -10px;
  }
</style>

<script>
  // Event delegation so the toggle survives View Transitions swaps.
  document.addEventListener('click', (e) => {
    const target = e.target as Element;
    const menu = document.getElementById('mobile-menu');
    if (!menu) return;

    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      document
        .querySelector('[data-menu-toggle]')
        ?.setAttribute('aria-expanded', String(open));
    };

    if (target.closest('[data-menu-toggle]')) {
      setOpen(menu.classList.contains('hidden'));
    } else if (target.closest('#mobile-menu a, #mobile-menu button')) {
      // Includes the console entry: leaving the menu open behind the overlay
      // would mean dismissing the console only reveals a menu nobody asked for.
      setOpen(false);
    }
  });

  // Escape closes the menu — a trap with no way out is worse than no menu.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const menu = document.getElementById('mobile-menu');
    if (!menu || menu.classList.contains('hidden')) return;
    menu.classList.add('hidden');
    const toggle = document.querySelector<HTMLElement>('[data-menu-toggle]');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.focus();
  });

  function initNav() {
    const nav = document.querySelector<HTMLElement>('.site-nav');
    if (!nav) return;

    // ── the bar's surface ──────────────────────────────
    const sentinel = () => nav.classList.toggle('site-nav--scrolled', window.scrollY > 8);
    sentinel();
    window.addEventListener('scroll', sentinel, { passive: true });

    // ── scrollspy ──────────────────────────────────────
    // Only meaningful on the single-page views, where the sections exist.
    const linksBySection = new Map<string, HTMLElement[]>();
    document.querySelectorAll<HTMLElement>('[data-section]').forEach((el) => {
      const key = el.dataset.section!;
      linksBySection.set(key, [...(linksBySection.get(key) ?? []), el]);
    });

    const sections = [...linksBySection.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    if (!sections.length) return;

    // Anything already marked active by the server (a sub-route) stays put.
    if (document.querySelector('.nav-link--active')) return;

    const mark = (id: string | null) => {
      linksBySection.forEach((els, key) =>
        els.forEach((el) => el.classList.toggle('nav-link--active', key === id))
      );
    };

    const visible = new Set<string>();
    const spy = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        }
        // With several sections in view, the topmost one in document order wins.
        const current = sections.find((s) => visible.has(s.id));
        mark(current?.id ?? null);
      },
      // The band sits below the sticky bar and stops short of the fold, so a
      // section counts as "current" only once it genuinely occupies the screen.
      { rootMargin: '-88px 0px -55% 0px' }
    );

    sections.forEach((s) => spy.observe(s));
  }

  initNav();
  document.addEventListener('astro:page-load', initNav);
</script>
