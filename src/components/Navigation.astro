---
import LanguageSwitcher from './LanguageSwitcher.jsx';

const { locale, t } = Astro.props;
const base = `/${locale}`;
const path = Astro.url.pathname;

const links = [
  { href: `${base}/#work`, label: t.nav.work, match: '/projects' },
  { href: `${base}/#about`, label: t.nav.about, match: null },
  { href: `${base}/#contact`, label: t.nav.contact, match: null }
];

const isActive = (link) => link.match !== null && path.includes(link.match);
---

<header class="site-nav sticky top-0 z-40">
  <div
    class="mx-auto flex h-16 w-full max-w-site items-center justify-end gap-8 px-6 md:px-16"
  >
    <nav class="hidden items-center gap-8 md:flex" aria-label="Main">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={['nav-link label', { 'nav-link--active': isActive(link) }]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <LanguageSwitcher client:load locale={locale} path={path} />

    <button
      type="button"
      class="nav-hamburger md:hidden"
      data-menu-toggle
      aria-label="Menu"
      aria-controls="mobile-menu"
    >
      三
    </button>
  </div>

  <nav id="mobile-menu" class="hidden md:hidden" aria-label="Main mobile">
    <div class="flex flex-col gap-5 px-6 pb-8 pt-4">
      {
        links.map((link) => (
          <a href={link.href} class="nav-link label">
            {link.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<style>
  .site-nav {
    /* Transparent over washi — only a breath of a border below. */
    border-bottom: 1px solid rgba(0, 0, 0, 0.04);
  }

  #mobile-menu {
    background-color: var(--washi);
    border-bottom: 1px solid rgba(0, 0, 0, 0.04);
  }

  .nav-link {
    color: var(--sumi-ink);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: border-color 300ms ease, color 300ms ease;
  }

  .nav-link:hover {
    color: var(--indigo);
  }

  .nav-link--active {
    border-bottom-color: var(--vermilion);
  }

  .nav-hamburger {
    font-family: 'Noto Serif JP', serif;
    font-size: 18px;
    line-height: 1;
    color: var(--sumi-ink);
    padding: 8px;
  }
</style>

<script>
  // Event delegation so the toggle survives View Transitions swaps.
  document.addEventListener('click', (e) => {
    const target = e.target as Element;
    const menu = document.getElementById('mobile-menu');
    if (!menu) return;
    if (target.closest('[data-menu-toggle]')) {
      menu.classList.toggle('hidden');
    } else if (target.closest('#mobile-menu a')) {
      menu.classList.add('hidden');
    }
  });
</script>
