---
// Unit stamp. This was a hanko — a vermilion name seal pressed off-square.
// On an industrial surface the same idea reads as a stencilled unit marking:
// chamfered, square to the grid, safety yellow instead of seal red.
const { kanji = '技', size = 72 } = Astro.props;
---

<span class="seal" style={`--seal-size:${size}px`} aria-hidden="true">
  <span class="seal-glyph">{kanji}</span>
</span>

<style>
  .seal {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--seal-size);
    height: var(--seal-size);
    background-color: var(--steel-raised);
    clip-path: var(--clip-chamfer-sm);
    box-shadow: inset 0 0 0 1.5px var(--volt);
  }

  .seal-glyph {
    font-family: 'Zen Kaku Gothic New', sans-serif;
    font-weight: 500;
    font-size: calc(var(--seal-size) * 0.46);
    line-height: 1;
    color: var(--volt);
  }
</style>
