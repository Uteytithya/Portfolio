---
import { getCollection } from 'astro:content';
import SectionHeader from './SectionHeader.astro';
import KanjiGhost from './KanjiGhost.astro';
import ProjectCard from './ProjectCard.astro';

// `as` lets the standalone /projects/ page promote this masthead to the page's
// h1; on the home page it stays an h2 beneath the hero.
const { locale, t, as = 'h2' } = Astro.props;

const entries = (
  await getCollection('projects', ({ id }) => id.startsWith(`${locale}/`))
).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

// First paragraph of the markdown body serves as the card description.
const excerpt = (body) =>
  (body ?? '').trim().split(/\r?\n\s*\r?\n/)[0]?.replace(/\r?\n/g, ' ') ?? '';
---

<section id="work" class="section">
  <SectionHeader
    as={as}
    num={t.work.num}
    kanji={t.work.kanji}
    title={t.work.title}
    sub={t.work.sub}
  />

  <div class="mt-16 flex flex-col gap-24">
    {
      entries.map((entry, i) => (
        <ProjectCard
          index={String(i + 1).padStart(2, '0')}
          title={entry.data.title}
          category={entry.data.category}
          year={entry.data.year}
          description={excerpt(entry.body)}
          image={entry.data.image}
          stack={entry.data.stack}
          slug={entry.id.split('/')[1]}
          external={entry.data.repo ?? entry.data.link}
          externalLabel={
            entry.data.repo
              ? t.work.viewOnGitHub
              : entry.data.link
                ? t.work.visitSite
                : null
          }
          flipped={i % 2 === 1}
          titleAs={as === 'h1' ? 'h2' : 'h3'}
        />
      ))
    }
  </div>

  <KanjiGhost kanji="作" />
</section>
