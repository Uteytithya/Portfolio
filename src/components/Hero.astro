---
import { Image } from 'astro:assets';
import Divider from './Divider.astro';
import KanjiGhost from './KanjiGhost.astro';
import Seal from './Seal.astro';
import portrait from '../assets/profile.jpg';

const { locale, t } = Astro.props;
---

<section id="intro" class="relative flex min-h-[86vh] flex-col items-center md:flex-row">
  <!-- vertical kana rail, running down the outer edge -->
  <span class="hero-rail" aria-hidden="true">{t.hero.rail}</span>

  <div class="reveal w-full py-16 md:w-[46%] md:py-24">
    <p class="hero-eyebrow">
      <span class="marker" aria-hidden="true"></span>
      <span>{t.hero.eyebrow}</span>
    </p>

    <h1 class="font-display text-hero mt-5 text-bone">{t.hero.headline}</h1>

    <!-- Registration rule. This was a brush stroke; on an engineered surface
         the same job is done by a measured line with a marked origin. -->
    <div class="hero-rule" aria-hidden="true">
      <span class="hero-rule-run"></span>
      <span class="hero-rule-tick"></span>
    </div>

    <p class="hero-subtitle mt-7">{t.hero.subtitle}</p>
    <div class="mt-9">
      <Divider />
    </div>
    <p class="mt-9 max-w-md text-ash">{t.hero.body}</p>

    <div class="mt-12 flex flex-wrap items-center gap-5">
      <a href={`/${locale}/#work`} class="hero-cta">{t.hero.cta}</a>
      <a href={`/${locale}/#contact`} class="hero-cta-ghost">{t.hero.ctaAlt}</a>
    </div>
  </div>

  <div
    class="relative flex w-full items-center justify-center pb-20 md:w-[54%] md:self-stretch md:pb-0"
  >
    <figure class="hero-portrait reveal">
      <!-- The portrait is the LCP element on every first paint, so it is served
           as responsive AVIF/WebP, eager, and fetched ahead of everything else. -->
      <Image
        src={portrait}
        alt={t.hero.portraitAlt ?? 'Uteytithya Nuon'}
        widths={[260, 360, 520, 720]}
        sizes="(min-width: 768px) 28vw, 78vw"
        loading="eager"
        fetchpriority="high"
        quality={82}
      />
      <span class="portrait-bracket portrait-bracket--tl" aria-hidden="true"></span>
      <span class="portrait-bracket portrait-bracket--br" aria-hidden="true"></span>
      <figcaption class="portrait-seal">
        <Seal kanji="技" size={70} />
      </figcaption>
      <figcaption class="portrait-caption data">{t.hero.portraitCaption}</figcaption>
    </figure>
  </div>

  <!-- Decorative cue duplicating the About nav link. Hidden from assistive tech,
       so it must leave the tab order too — a focusable aria-hidden element is a
       stop that screen reader users land on with nothing announced. -->
  <a
    href={`/${locale}/#about`}
    class="hero-scroll"
    aria-hidden="true"
    tabindex="-1"
  >
    <span class="hero-scroll-text">{t.hero.scroll}</span>
    <span class="hero-scroll-line"></span>
  </a>

  <KanjiGhost kanji="創" />
</section>

<style>
  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 11.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--volt);
  }

  html[lang='ja'] .hero-eyebrow {
    letter-spacing: 0.14em;
    text-transform: none;
  }

  .hero-rule {
    display: flex;
    align-items: center;
    gap: 0;
    margin-top: 18px;
    width: min(320px, 80%);
  }

  .hero-rule-run {
    flex: 1;
    height: 1px;
    background-color: var(--edge-strong);
  }

  /* The origin mark: the one piece of volt in the rule. */
  .hero-rule-tick {
    width: 48px;
    height: 2px;
    background-color: var(--volt);
  }

  .hero-subtitle {
    font-size: 19px;
    color: var(--ash);
  }

  html[lang='ja'] .hero-subtitle {
    font-size: 17px;
  }

  /* Chamfered, outlined, filled only on hover — volt stays structural rather
     than becoming a large flat block of colour. */
  .hero-cta {
    position: relative;
    padding: 13px 32px;
    background-color: transparent;
    color: var(--volt);
    clip-path: var(--clip-chamfer-sm);
    box-shadow: inset 0 0 0 1.5px var(--volt);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background-color 220ms ease,
      color 220ms ease;
  }

  html[lang='ja'] .hero-cta {
    letter-spacing: 0.08em;
    text-transform: none;
  }

  .hero-cta:hover {
    background-color: var(--volt);
    color: var(--void);
  }

  .hero-cta-ghost {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ash);
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 1px solid var(--edge-strong);
    transition:
      color 220ms ease,
      border-color 220ms ease;
  }

  html[lang='ja'] .hero-cta-ghost {
    letter-spacing: 0.08em;
    text-transform: none;
  }

  .hero-cta-ghost:hover {
    color: var(--volt);
    border-bottom-color: var(--volt);
  }

  /* Vertical kana rail on the far left — visible only on wide screens */
  .hero-rail {
    position: absolute;
    left: -40px;
    top: 50%;
    transform: translateY(-50%);
    writing-mode: vertical-rl;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 11px;
    letter-spacing: 0.5em;
    color: var(--ash-faint);
    user-select: none;
  }

  @media (max-width: 1360px) {
    .hero-rail {
      display: none;
    }
  }

  /* The print is now a plate: chamfered, square to the grid, no cream mount
     and no sepia. */
  .hero-portrait {
    position: relative;
  }

  .hero-portrait img {
    position: relative;
    display: block;
    width: clamp(260px, 28vw, 360px);
    height: auto;
    clip-path: var(--clip-chamfer);
    filter: grayscale(55%) contrast(1.08) brightness(0.92);
    transition: filter 500ms ease;
  }

  .hero-portrait:hover img {
    filter: none;
  }

  /* Brackets on the two corners the chamfer leaves square. */
  .portrait-bracket {
    position: absolute;
    width: 18px;
    height: 18px;
    border: 0 solid var(--volt);
    pointer-events: none;
    z-index: 2;
  }

  .portrait-bracket--tl {
    top: -6px;
    left: -6px;
    border-top-width: 2px;
    border-left-width: 2px;
  }

  .portrait-bracket--br {
    bottom: -6px;
    right: -6px;
    border-bottom-width: 2px;
    border-right-width: 2px;
  }

  .portrait-seal {
    position: absolute;
    left: -26px;
    bottom: 34px;
    z-index: 3;
  }

  .portrait-caption {
    position: absolute;
    right: -18px;
    bottom: -34px;
    writing-mode: vertical-rl;
    font-size: 10.5px;
    letter-spacing: 0.2em;
    color: var(--ash-faint);
  }

  @media (max-width: 767px) {
    .hero-portrait img {
      width: min(260px, 78vw);
    }

    .portrait-seal {
      left: -14px;
      bottom: 24px;
    }

    .portrait-caption {
      right: -10px;
    }
  }

  .hero-scroll {
    position: absolute;
    left: 0;
    bottom: 28px;
    display: none;
    align-items: center;
    gap: 14px;
    text-decoration: none;
  }

  @media (min-width: 768px) {
    .hero-scroll {
      display: flex;
    }
  }

  .hero-scroll-text {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 10.5px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ash-faint);
  }

  .hero-scroll-line {
    width: 56px;
    height: 1px;
    background-color: var(--volt);
    opacity: 0.5;
    transform-origin: left;
    animation: reach 2.8s ease-in-out infinite;
  }

  @keyframes reach {
    0%,
    100% {
      transform: scaleX(0.4);
      opacity: 0.25;
    }
    50% {
      transform: scaleX(1);
      opacity: 0.7;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-line {
      animation: none;
      transform: scaleX(1);
    }
  }
</style>
