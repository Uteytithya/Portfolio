---
const { kanji, tone = 'dark' } = Astro.props;
---

<!-- The glyph is meant to bleed off the section's right edge. Left to itself it
     bled past the *viewport* too, which let every page scroll sideways by ~44px.
     The wrapper pins it to the section box and clips the overhang, so the look
     is unchanged and the overflow can never reach the document.
     `clip` rather than `hidden`: hidden would make this a scroll container. -->
<span class="kanji-ghost-clip" aria-hidden="true">
  <span
    class:list={['kanji-ghost', { 'kanji-ghost--light': tone === 'light' }]}
  >
    {kanji}
  </span>
</span>

<style>
  .kanji-ghost-clip {
    position: absolute;
    inset: 0;
    overflow: clip;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .kanji-ghost {
    position: absolute;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    font-family: 'Zen Old Mincho', serif;
    font-weight: 400;
    font-size: 200px;
    line-height: 1;
    color: rgba(0, 0, 0, 0.03);
    writing-mode: vertical-rl;
    user-select: none;
    pointer-events: none;
  }

  .kanji-ghost--light {
    color: rgba(247, 243, 235, 0.05);
  }

  @media (max-width: 767px) {
    .kanji-ghost-clip {
      display: none;
    }
  }
</style>
