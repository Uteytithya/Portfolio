---
import SectionHeader from './SectionHeader.astro';
import KanjiGhost from './KanjiGhost.astro';

const { t } = Astro.props;
---

<section id="experience" class="section">
  <SectionHeader
    num={t.experience.num}
    kanji={t.experience.kanji}
    title={t.experience.title}
    sub={t.experience.sub}
  />

  <!-- A single thread of ink, with the years knotted along it. -->
  <ol class="timeline">
    {
      t.experience.items.map((item) => (
        <li class="timeline-entry reveal">
          <span class="entry-node" aria-hidden="true" />

          <p class="entry-period">{item.period}</p>
          <h3 class="entry-role font-display mt-2">{item.role}</h3>

          <p class="entry-org mt-1">
            {item.orgUrl ? (
              <a href={item.orgUrl} target="_blank" rel="noopener noreferrer">
                {item.org}
              </a>
            ) : (
              item.org
            )}
          </p>

          {item.body && <p class="entry-body mt-4">{item.body}</p>}

          {item.tags?.length > 0 && (
            <ul class="entry-tags mt-5">
              {item.tags.map((tag) => (
                <li class="entry-chip">{tag}</li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ol>

  <KanjiGhost kanji="歴" />
</section>

<style>
  .timeline {
    position: relative;
    margin-top: 56px;
    padding-left: 30px;
    border-left: 1px solid var(--edge);
    list-style: none;
  }

  .timeline-entry {
    position: relative;
    padding-bottom: 56px;
  }

  .timeline-entry:last-child {
    padding-bottom: 0;
  }

  /* Station marker on the rail: a diamond, hollow until it is the live one.
     Nothing in this system is round. */
  .entry-node {
    position: absolute;
    left: -35px;
    top: 7px;
    width: 8px;
    height: 8px;
    background-color: var(--void);
    border: 1.5px solid var(--volt);
    transform: rotate(45deg);
  }

  /* The current post is the filled marker. It used to be alert red, which on
     an industrial surface reads as a fault rather than as "you are here". */
  .timeline-entry:first-child .entry-node {
    background-color: var(--volt);
  }

  .entry-period {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 11.5px;
    letter-spacing: 0.14em;
    color: var(--ash);
    opacity: 0.7;
  }

  html[lang='ja'] .entry-period {
    letter-spacing: 0.12em;
  }

  .entry-role {
    font-size: 25px;
    line-height: 1.25;
    color: var(--bone);
  }

  html[lang='ja'] .entry-role {
    font-size: 22px;
    line-height: 1.5;
  }

  .entry-org {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--signal);
  }

  .entry-org a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 300ms ease;
  }

  .entry-org a:hover {
    border-bottom-color: var(--signal);
  }

  .entry-body {
    max-width: 62ch;
    color: var(--ash);
  }

  .entry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
  }

  .entry-chip {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--ash);
    border-left: 2px solid var(--edge-strong);
    padding: 5px 10px;
    background-color: var(--steel-deep);
  }

  @media (max-width: 767px) {
    .timeline {
      padding-left: 22px;
    }

    .entry-node {
      left: -27px;
    }
  }
</style>
