---
import SectionHeader from './SectionHeader.astro';
import KanjiGhost from './KanjiGhost.astro';

const { t } = Astro.props;
---

<section id="experience" class="section">
  <SectionHeader
    num={t.experience.num}
    kanji={t.experience.kanji}
    title={t.experience.title}
    sub={t.experience.sub}
  />

  <!-- A single thread of ink, with the years knotted along it. -->
  <ol class="timeline">
    {
      t.experience.items.map((item) => (
        <li class="timeline-entry reveal">
          <span class="entry-node" aria-hidden="true" />

          <p class="entry-period">{item.period}</p>
          <h3 class="entry-role font-display mt-2">{item.role}</h3>

          <p class="entry-org mt-1">
            {item.orgUrl ? (
              <a href={item.orgUrl} target="_blank" rel="noopener noreferrer">
                {item.org}
              </a>
            ) : (
              item.org
            )}
          </p>

          {item.body && <p class="entry-body mt-4">{item.body}</p>}

          {item.tags?.length > 0 && (
            <ul class="entry-tags mt-5">
              {item.tags.map((tag) => (
                <li class="entry-chip">{tag}</li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ol>

  <KanjiGhost kanji="歴" />
</section>

<style>
  .timeline {
    position: relative;
    margin-top: 56px;
    padding-left: 30px;
    border-left: 1px solid var(--paper-edge);
    list-style: none;
  }

  .timeline-entry {
    position: relative;
    padding-bottom: 56px;
  }

  .timeline-entry:last-child {
    padding-bottom: 0;
  }

  /* Knot on the thread — centred over the 1px rule. */
  .entry-node {
    position: absolute;
    left: -35px;
    top: 6px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background-color: var(--washi);
    border: 1px solid var(--gold);
  }

  /* The most recent post sits in vermilion; the rest recede. */
  .timeline-entry:first-child .entry-node {
    background-color: var(--vermilion);
    border-color: var(--vermilion);
  }

  .entry-period {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.22em;
    color: var(--stone);
    opacity: 0.7;
  }

  html[lang='ja'] .entry-period {
    letter-spacing: 0.12em;
  }

  .entry-role {
    font-size: 25px;
    line-height: 1.25;
    color: var(--sumi-ink);
  }

  html[lang='ja'] .entry-role {
    font-size: 22px;
    line-height: 1.5;
  }

  .entry-org {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--indigo);
  }

  .entry-org a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 300ms ease;
  }

  .entry-org a:hover {
    border-bottom-color: var(--indigo);
  }

  .entry-body {
    max-width: 62ch;
    color: var(--stone);
  }

  .entry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
  }

  .entry-chip {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--stone);
    border: 1px solid var(--paper-edge);
    border-radius: 2px;
    padding: 4px 10px;
    background-color: var(--washi-warm);
  }

  @media (max-width: 767px) {
    .timeline {
      padding-left: 22px;
    }

    .entry-node {
      left: -27px;
    }
  }
</style>
