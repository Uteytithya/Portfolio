---
const {
  index,
  title,
  category,
  year,
  description,
  image,
  stack = [],
  external,
  externalLabel,
  flipped = false,
  // Sits one level below whatever masthead the section rendered, so the
  // document outline never skips a level.
  titleAs: Title = 'h3'
} = Astro.props;
---

<article
  class:list={[
    'project-card reveal flex flex-col md:flex-row',
    { 'md:flex-row-reverse': flipped }
  ]}
>
  {
    external && (
      <a
        class="card-cover"
        href={external}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={title}
      />
    )
  }

  <div class="card-media md:w-3/5">
    <img class="card-img" src={image} alt={title} loading="lazy" />
    <span class="card-index" aria-hidden="true">{index}</span>
  </div>

  <div class="card-body md:w-2/5">
    <div class="card-meta">
      <span class="tag">{category}</span>
      <span class="card-year">{year}</span>
    </div>

    <Title class="card-title font-display mt-4 text-sumi-ink">{title}</Title>

    {description && <p class="mt-4 text-stone">{description}</p>}

    {
      stack.length > 0 && (
        <ul class="card-stack mt-6">
          {stack.map((item) => (
            <li class="stack-chip">{item}</li>
          ))}
        </ul>
      )
    }

    {
      external && externalLabel && (
        <a
          class="card-link mt-7"
          href={external}
          target="_blank"
          rel="noopener noreferrer"
        >
          {externalLabel}
        </a>
      )
    }
  </div>
</article>

<style>
  .project-card {
    position: relative;
    background-color: #fbf8f1;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 2px;
    box-shadow: inset 0 0 0 1px rgba(34, 58, 94, 0.03),
      0 2px 8px var(--ink-wash);
    transition: transform 400ms ease, box-shadow 400ms ease;
  }

  /* Vermilion thread along the left edge, revealed on hover. */
  .project-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: var(--vermilion);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 400ms ease;
    z-index: 3;
  }

  .project-card:hover {
    transform: translateY(-2px);
    box-shadow: inset 0 0 0 1px rgba(34, 58, 94, 0.03),
      0 8px 24px rgba(43, 41, 40, 0.08);
  }

  .project-card:hover::before {
    transform: scaleY(1);
  }

  .card-cover {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .card-media {
    position: relative;
    overflow: hidden;
  }

  .card-img {
    display: block;
    height: 100%;
    min-height: 260px;
    width: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 600ms ease, transform 700ms ease;
  }

  .project-card:hover .card-img {
    filter: grayscale(0%);
    transform: scale(1.02);
  }

  /* Big plate number, sitting over the image corner */
  .card-index {
    position: absolute;
    left: 20px;
    top: 12px;
    z-index: 2;
    font-family: 'Zen Old Mincho', serif;
    font-weight: 600;
    font-size: 60px;
    line-height: 1;
    color: var(--washi);
    mix-blend-mode: difference;
    opacity: 0.75;
    pointer-events: none;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 32px;
  }

  @media (min-width: 768px) {
    .card-body {
      padding: 48px;
    }
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .card-meta::after {
    content: '';
    flex: 1;
    height: 1px;
    background-color: var(--paper-edge);
  }

  .card-year {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--stone);
    opacity: 0.75;
    order: 3;
  }

  .card-title {
    font-size: 31px;
    line-height: 1.2;
  }

  html[lang='ja'] .card-title {
    font-size: 27px;
    line-height: 1.4;
  }

  .card-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .stack-chip {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--stone);
    border: 1px solid var(--paper-edge);
    border-radius: 2px;
    padding: 4px 10px;
    background-color: rgba(247, 243, 235, 0.6);
  }

  .card-link {
    position: relative;
    z-index: 2;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--indigo);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    align-self: flex-start;
    transition: border-color 300ms ease, gap 300ms ease;
  }

  .card-link:hover {
    border-bottom-color: var(--indigo);
  }
</style>
