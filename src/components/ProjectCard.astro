---
const {
  index,
  title,
  category,
  year,
  description,
  image,
  stack = [],
  external,
  externalLabel,
  flipped = false,
  // Sits one level below whatever masthead the section rendered, so the
  // document outline never skips a level.
  titleAs: Title = 'h3'
} = Astro.props;
---

<article
  class:list={[
    'project-card reveal flex flex-col md:flex-row',
    { 'md:flex-row-reverse': flipped }
  ]}
>
  {
    external && (
      <a
        class="card-cover"
        href={external}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={title}
      />
    )
  }

  <div class="card-media md:w-3/5">
    <img class="card-img" src={image} alt={title} loading="lazy" />
    <span class="card-index" aria-hidden="true">{index}</span>
  </div>

  <div class="card-body md:w-2/5">
    <div class="card-meta">
      <span class="tag">{category}</span>
      <span class="card-year">{year}</span>
    </div>

    <Title class="card-title font-display mt-4 text-bone">{title}</Title>

    {description && <p class="mt-4 text-ash">{description}</p>}

    {
      stack.length > 0 && (
        <ul class="card-stack mt-6">
          {stack.map((item) => (
            <li class="stack-chip">{item}</li>
          ))}
        </ul>
      )
    }

    {
      external && externalLabel && (
        <a
          class="card-link mt-7"
          href={external}
          target="_blank"
          rel="noopener noreferrer"
        >
          {externalLabel}
        </a>
      )
    }
  </div>
</article>

<style>
  /* The card was a cream paper plate. It is now a steel one: chamfered at
     top-right and bottom-left, bracketed at the two corners that stay square. */
  .project-card {
    position: relative;
    background-color: var(--steel);
    clip-path: var(--clip-chamfer);
    transition: background-color 300ms ease;
  }

  .project-card:hover {
    background-color: var(--steel-raised);
  }

  /* The live edge: a volt rule that runs down the card on hover. */
  .project-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: var(--volt);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 400ms ease;
    z-index: 3;
  }

  .project-card:hover::before {
    transform: scaleY(1);
  }

  /* Bracket on the top-left square corner. */
  .project-card::after {
    content: '';
    position: absolute;
    top: 10px;
    left: 10px;
    width: 14px;
    height: 14px;
    border-top: 1.5px solid var(--volt);
    border-left: 1.5px solid var(--volt);
    opacity: 0.55;
    pointer-events: none;
    z-index: 3;
    transition: opacity 300ms ease;
  }

  .project-card:hover::after {
    opacity: 1;
  }

  .card-cover {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .card-media {
    position: relative;
    overflow: hidden;
    background-color: var(--steel-deep);
  }

  .card-img {
    display: block;
    height: 100%;
    min-height: 260px;
    width: 100%;
    object-fit: cover;
    /* No grayscale. That filter existed to tame colourful photo thumbnails;
       the artwork is now drawn in this palette, so desaturating it only
       greys out the volt scan marks it is supposed to be showing off. */
    filter: brightness(0.82);
    transition: filter 500ms ease, transform 600ms ease;
  }

  .project-card:hover .card-img {
    filter: brightness(1);
    transform: scale(1.02);
  }

  /* The index reads as a unit number stencilled on the plate. */
  .card-index {
    position: absolute;
    left: 18px;
    top: 10px;
    z-index: 2;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 48px;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: var(--volt);
    opacity: 0.5;
    pointer-events: none;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 32px;
  }

  @media (min-width: 768px) {
    .card-body {
      padding: 48px;
    }
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .card-meta::after {
    content: '';
    flex: 1;
    height: 1px;
    background-color: var(--edge-strong);
  }

  .card-year {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    color: var(--ash-faint);
    order: 3;
  }

  .card-title {
    font-size: 27px;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  html[lang='ja'] .card-title {
    font-size: 24px;
    line-height: 1.4;
    text-transform: none;
  }

  .card-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .stack-chip {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 11px;
    letter-spacing: 0.04em;
    padding: 5px 10px;
    color: var(--ash);
    background-color: var(--steel-deep);
    border-left: 2px solid var(--edge-strong);
  }

  .card-link {
    display: inline-block;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--volt);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    align-self: flex-start;
    position: relative;
    z-index: 2;
  }

  html[lang='ja'] .card-link {
    letter-spacing: 0.08em;
    text-transform: none;
  }

  .card-link:hover {
    color: var(--bone);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card::before,
    .card-img,
    .project-card::after {
      transition: none;
    }
  }
</style>
