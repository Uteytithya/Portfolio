---
import SectionHeader from './SectionHeader.astro';
import KanjiGhost from './KanjiGhost.astro';

const { t } = Astro.props;
---

<section id="about" class="section">
  <SectionHeader
    num={t.about.num}
    kanji={t.about.kanji}
    title={t.about.title}
    sub={t.about.sub}
  />

  <div class="mt-14 grid grid-cols-1 gap-16 lg:grid-cols-[minmax(0,560px)_minmax(0,1fr)]">
    <div class="about-prose reveal">
      <div class="space-y-6 text-ash">
        <p class="about-lead">{t.about.body1}</p>
        <p>{t.about.body2}</p>
      </div>

      <figure class="mt-14">
        <blockquote class="about-quote">{t.about.quote}</blockquote>
        <figcaption class="about-quote-translation mt-3">
          {t.about.quoteTranslation}
        </figcaption>
      </figure>
    </div>

    <!-- ledger of plain facts, right column -->
    <dl class="about-facts reveal">
      {
        t.about.facts.map((fact) => (
          <div class="fact-row">
            <dt class="fact-label">{fact.label}</dt>
            <dd class="fact-value">{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <KanjiGhost kanji="間" />
</section>

<style>
  .about-lead {
    font-size: 20px;
    line-height: 1.75;
    color: var(--bone);
  }

  html[lang='ja'] .about-lead {
    font-size: 17px;
  }

  .about-quote {
    font-family: 'Zen Kaku Gothic New', sans-serif;
    font-weight: 500;
    font-size: 25px;
    color: var(--ash);
    letter-spacing: 0.12em;
    border-left: 2px solid var(--volt);
    padding-left: 20px;
  }

  .about-quote-translation {
    font-family: 'Zen Kaku Gothic New', sans-serif;
    font-weight: 400;
    font-size: 15px;
    color: var(--ash);
    opacity: 0.85;
    padding-left: 22px;
  }

  .about-facts {
    align-self: start;
  }

  .fact-row {
    display: grid;
    grid-template-columns: 108px 1fr;
    gap: 20px;
    padding: 16px 0;
    border-bottom: 1px solid var(--edge);
  }

  .fact-row:first-child {
    border-top: 1px solid var(--edge);
  }

  .fact-label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ash);
    opacity: 0.65;
    padding-top: 3px;
  }

  html[lang='ja'] .fact-label {
    letter-spacing: 0.1em;
  }

  .fact-value {
    font-size: 16px;
    color: var(--bone);
  }

  /* Frosted plates. Both of these are bare small text, which over the
     watermark measures 2.95:1 — well under the floor. On a plate it is
     4.66:1. See Backbone.astro for where those numbers come from. */
  @media (max-width: 1239px) {
    .about-prose,
    .about-facts {
      background-color: rgba(21, 24, 28, 0.72);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      padding: 24px 20px;
      clip-path: var(--clip-chamfer);
    }

    .fact-row:first-child {
      border-top: none;
    }
  }
</style>
