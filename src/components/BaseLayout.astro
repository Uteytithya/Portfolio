---
import { ClientRouter } from 'astro:transitions';
import Head from './Head.astro';
import PaperGrain from './PaperGrain.astro';
import Backbone from './Backbone.astro';
import '../styles/global.css';

const {
  locale = 'en',
  title,
  description = '',
  skipLabel,
  noindex = false
} = Astro.props;

// The skip link is the first thing a screen reader or a Tab press meets, so it
// speaks the page's own language rather than defaulting to English.
const skip = skipLabel ?? (locale === 'ja' ? '本文へスキップ' : 'Skip to content');

// One family now carries the entire bilingual site: Zen Kaku Gothic New, for
// display, body and labels alike. It draws its Latin alongside its kana, so
// English and Japanese share one skeleton.
//
// Zen Old Mincho is gone. A brush serif has no place on an industrial surface,
// and because nothing references it any more its three weights are never
// fetched — an unused @font-face is not downloaded. That is ~175 KB saved
// without touching the subsetting pipeline.
//
// Self-hosted, subset by scripts/build-fonts.py. Served from Google these are
// CJK fonts split into ~120 unicode-range slices, and the ~55 Japanese
// characters on the English page alone dragged in 1.35 MB across 118 requests.
//
// Both weights below carry first paint: 400 for body, 500 for every heading.
// `crossorigin` is required on font preloads even same-origin, or the browser
// fetches the file twice.
const PRELOAD = [
  // The h1 is the LCP element on most pages and it is set in Oxanium, so the
  // variable file leads. 12 KB for the whole weight axis.
  '/fonts/oxanium-var.woff2',
  '/fonts/zen-kaku-gothic-new-400.woff2',
  '/fonts/zen-kaku-gothic-new-500.woff2'
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <Head
      locale={locale}
      title={title}
      description={description}
      noindex={noindex}
    />

    {
      PRELOAD.map((href) => (
        <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
      ))
    }
    <!-- Same origin now, so there is no third-party round-trip to hide behind a
         media=print trick — this is a small local stylesheet. `font-display:
         swap` inside it keeps text readable while the faces land. -->
    <link rel="stylesheet" href="/fonts/fonts.css" />

    <!-- Reveal animations start at opacity 0 and are cleared by script. Without
         this the whole page would be blank to anyone browsing without JS.
         `.reveal-group > *` has to be here too — the children carry the
         opacity in a group, so covering only the container would still
         leave every staggered item invisible. -->
    <noscript>
      <style>
        .reveal,
        .reveal-group > * {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>

    <ClientRouter />
  </head>
  <body>
    <div class="nav-progress" data-nav-progress aria-hidden="true"></div>
    <PaperGrain />
    <a href="#main" class="skip-link">{skip}</a>
    <Backbone />
    <slot name="nav" />
    <main id="main" class="mx-auto w-full max-w-site px-6 md:px-16">
      <slot />
    </main>
    <slot name="footer" />
    <script>
      // Scroll reveal — sections drift in once, then rest. A `.reveal-group`
      // is observed exactly like a `.reveal`; the difference is only which
      // element carries the opacity, and that is settled in CSS.
      function observeReveals() {
        const els = document.querySelectorAll(
          '.reveal:not(.revealed), .reveal-group:not(.revealed)'
        );
        if (!els.length) return;

        // Same reasoning as the noscript block: if we cannot observe, show
        // everything immediately rather than leave the page invisible.
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('revealed'));
          return;
        }

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -5% 0px' }
        );
        els.forEach((el) => io.observe(el));
      }

      function init() {
        observeReveals();
      }

      init();
      document.addEventListener('astro:page-load', init);

      // ── navigation progress ──────────────────────────────
      // Module scope, so these bind once for the life of the tab. Binding
      // them inside init() would stack a fresh copy on every client-side
      // navigation, each closed over a bar that has since been swapped out.
      //
      // The bar element itself IS swapped, so it is looked up per event
      // rather than captured here.
      let progressTimer: number | undefined;

      const stopProgress = () => {
        clearTimeout(progressTimer);
        document
          .querySelector('[data-nav-progress]')
          ?.classList.remove('is-loading');
      };

      document.addEventListener('astro:before-preparation', () => {
        // A navigation served from cache finishes in a few milliseconds, and
        // a bar that appears and vanishes inside that window reads as a
        // glitch. Nothing is shown unless the fetch outlasts the delay.
        progressTimer = window.setTimeout(() => {
          document
            .querySelector('[data-nav-progress]')
            ?.classList.add('is-loading');
        }, 140);
      });

      // after-swap fires before page-load and before the new document has
      // painted, which is the moment the old bar stops being true.
      document.addEventListener('astro:after-swap', stopProgress);
      document.addEventListener('astro:page-load', stopProgress);
    </script>
  </body>
</html>
