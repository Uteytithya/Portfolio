---
// Editorial section masthead: rule, index numerals, title, counter-language subtitle.
// On the single-page views this is one section among several, so it renders an
// <h2>. On a standalone page (work index, colophon) the same masthead *is* the
// page's heading — `as="h1"` lets those pages say so without restyling it.
const { num, kanji, title, sub, as: Heading = 'h2' } = Astro.props;
---

<header class="section-header reveal">
  <div class="header-rule">
    <span class="header-kanji">{kanji}</span>
    <span class="header-line"></span>
    <span class="header-num">{num}</span>
  </div>
  <Heading class="font-display text-section mt-6 text-bone">{title}</Heading>
  <p class="header-sub mt-3">{sub}</p>
</header>

<style>
  .header-rule {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  /* The index glyph becomes a station marker: volt, square to the grid. */
  .header-kanji {
    font-family: 'Zen Kaku Gothic New', sans-serif;
    font-size: 14px;
    color: var(--volt);
    flex-shrink: 0;
  }

  /* The rule was a gradient of black, which is nothing at all on the void. */
  .header-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, var(--edge-strong), transparent);
  }

  .header-num {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 11.5px;
    letter-spacing: 0.14em;
    color: var(--ash-faint);
    flex-shrink: 0;
  }

  /* One of the few bits of small text with no plate under it, and the
     watermark runs behind it. --ash-faint would be 3.71:1 there. */
  @media (max-width: 1239px) {
    .header-num {
      color: var(--ash);
    }
  }

  .header-sub {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 11.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--volt);
    opacity: 0.85;
  }

  html[lang='ja'] .header-sub {
    font-family: 'Zen Kaku Gothic New', sans-serif;
    letter-spacing: 0.16em;
    text-transform: none;
  }
</style>
